  "characters": [
    { "id": "C01", "name": "刘兰芝", "image": "../images/kongque/C01.png", "description": "聪慧、勤劳、坚贞且重视尊严。核心主角，几乎所有主线与自主选择结局的必要角色。", "source": "core", "tags": ["个人尊严", "婚姻自主", "个人选择"] },
    { "id": "C02", "name": "焦仲卿", "image": "../images/kongque/C02.png", "description": "忠于爱情，但受母权、孝道和社会规范束缚。触发求情、誓言、诀别、远走与殉情。", "source": "core", "tags": ["爱情忠贞"] },
    { "id": "C03", "name": "焦母", "image": "../images/kongque/C03.png", "description": "专断强势的封建家长。制造主冲突，也可通过“醒悟”形成和解分支。", "source": "core", "tags": ["家庭权力", "礼教压迫"] },
    { "id": "C04", "name": "刘母", "image": "../images/kongque/C04.png", "description": "疼爱女儿，但缺乏对抗家族压力的能力。娘家情节的缓冲者，可提供安慰或劝婚。", "source": "core", "tags": [] },
    { "id": "C05", "name": "刘兄", "image": "../images/kongque/C05.png", "description": "重视权势、财富和家族利益。逼婚主因，推动悲剧进入婚礼阶段。", "source": "core", "tags": ["婚姻压力", "家庭权力"] },
    { "id": "C06", "name": "县令媒人", "image": "../images/kongque/C06.png", "description": "世俗婚姻安排的传递者。触发第一次说媒，提示兰芝受到外部关注。", "source": "core", "tags": ["婚姻压力", "社会舆论"] },
    { "id": "C07", "name": "太守媒人", "image": "../images/kongque/C07.png", "description": "权贵婚姻交易的执行者。触发太守府婚事及时间压力。", "source": "core", "tags": ["婚姻压力"] },
    { "id": "C08", "name": "太守之子", "image": "../images/kongque/C08.png", "description": "被安排的再婚对象，构成婚姻冲突，不简单塑造成绝对恶人。", "source": "core", "tags": ["婚姻压力"] },
    { "id": "C09", "name": "邻里乡民", "image": "../images/kongque/C09.png", "description": "社会舆论及公共见证者。可加强压力，也可在改写线中转化为互助力量。", "source": "core", "tags": ["社会舆论", "公共支持"] },
    { "id": "C10", "name": "孔雀双鸟", "image": "../images/kongque/C10.png", "description": "焦、刘爱情与传说记忆的象征。用于尾声、图鉴和神话圆满结局。", "source": "legend", "tags": ["爱情忠贞", "文化意象"] },
    { "id": "C11", "name": "智者／族老", "image": "../images/kongque/C11.png", "description": "游戏新增的调解角色。解锁族老调解、家庭协商等非悲剧路线。", "source": "added", "tags": ["公共支持", "命运改写"] },
    { "id": "C12", "name": "年幼侍女", "image": "../images/kongque/C12.png", "description": "兰芝的陪伴者与叙事见证人。传话、补充人物内心、给玩家提供线索。", "source": "core", "tags": [] }
