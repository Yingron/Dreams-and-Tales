  "combos": [
    { "scene": "S02", "characters": ["C01"], "event": "E01", "text": "鸡鸣入机织，夜夜不得息。兰芝勤勉持家，却始终得不到焦母的认可。", "source": "core" },
    { "scene": "S03", "characters": ["C03", "C01"], "event": "E02", "text": "焦母端坐堂前，责怪兰芝不守礼节。兰芝虽心怀委屈，仍以礼相答。", "source": "core" },
    { "scene": "S03", "characters": ["C02", "C03"], "event": "E03", "text": "仲卿在母亲面前为妻子求情，但焦母态度坚决，命他将兰芝遣归。", "source": "core" },
    { "scene": "S04", "characters": ["C01", "C02"], "event": "E06", "text": "“君当作磐石，妾当作蒲苇。蒲苇纫如丝，磐石无转移。”二人在离别处许下不变的誓言。", "source": "core" },
    { "scene": "S06", "characters": ["C05", "C01"], "event": "E09", "text": "兄长以家族利益相逼。兰芝孤立无援，只得暂且答应太守家的婚事。", "source": "core" },
    { "scene": "S09", "characters": ["C01"], "event": "E12", "text": "婚礼将至，兰芝脱下绣鞋，走向清池，以生命守住自己的誓言。", "source": "core" },
    { "scene": "S10", "characters": ["C02"], "event": "E13", "text": "仲卿在庭树下久久徘徊，最终走向东南枝，追随兰芝而去。", "source": "core" },
